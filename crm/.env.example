# Copie este arquivo para .env e preencha os valores.

# Dev: SQLite local. Produção: string de conexão PostgreSQL
# (ex: postgresql://usuario:senha@host:5432/stokes_crm)
DATABASE_URL="file:./dev.db"

# Gere com: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Token secreto para o endpoint de captura de leads via formulário (Wix/Zapier).
# Gere com: openssl rand -hex 24
INBOUND_API_TOKEN=""

# Número oficial do WhatsApp da Stokes Brasil (E.164, sem +)
WHATSAPP_NUMERO="5511940894977"

# URL pública onde o CRM está hospedado (sem barra no final)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
